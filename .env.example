# ============================================================
# teage-liu 环境变量模板
# 复制为 .env 后填入真实值，.env 已在 .gitignore 中忽略
# ============================================================

# ── LLM API Key ──
# 两种命名方式均支持，前端通过设置页配置 API Key 时会写入 LLM_MAIN_API_KEY /
# LLM_CONSOLIDATION_API_KEY；若手动设置环境变量，也可用 provider 默认命名
# （DEEPSEEK_API_KEY / ANTHROPIC_API_KEY / OPENAI_API_KEY / DASHSCOPE_API_KEY）。
# config.yaml 中占位符用 ${LLM_MAIN_API_KEY} 或 ${DEEPSEEK_API_KEY} 均可。
LLM_MAIN_API_KEY=
LLM_CONSOLIDATION_API_KEY=
DEEPSEEK_API_KEY=your_deepseek_api_key_here
BING_API_KEY=your_bing_api_key_here
BAIDU_API_KEY=your_baidu_api_key_here
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ── SMTP 配置（通知层使用，6.2） ──
# blog_monitor_joyehuang cron 工具与 NotifyHook 共用此配置
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_auth_code
NOTIFY_EMAIL=your_email@qq.com

# ── Webhook 通知（可选） ──
# 支持企业微信/钉钉/飞书 markdown 格式
WEBHOOK_URL=

# ── Teage API 认证（生产部署强烈建议设置） ──
# 留空则所有 API 端点无认证保护（仅本地开发适用）
# 设置后所有 /api/* 请求需携带 Authorization: Bearer <TEAGE_API_KEY>
TEAGE_API_KEY=
