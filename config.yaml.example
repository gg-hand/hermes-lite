# ============================================================
# hermes-lite 配置模板
# 复制为 config.yaml 后按需修改，API Key 使用 ${VAR} 环境变量
# 或直接填入明文（不推荐提交到仓库）
# ============================================================

llm:
  main_provider: deepseek
  main_model: deepseek-v4-flash
  main_api_key: ${DEEPSEEK_API_KEY}
  main_base_url: https://api.deepseek.com
  consolidation_provider: deepseek
  consolidation_model: deepseek-v4-flash
  consolidation_api_key: ${DEEPSEEK_API_KEY}
  consolidation_base_url: https://api.deepseek.com
  max_context_tokens: 200000
  context_threshold: 0.8
  activity_timeout: 60
  stream_total_timeout: 300

memory:
  chroma_path: data/chroma
  memory_md_path: data/memory.md
  consolidation_threshold: 15
  dedup_similarity_threshold: 0.85
  retrieval_top_k: 5
  retrieval_relevance_threshold: 0.6
  surprise_gate_enabled: true
  surprise_similarity_threshold: 0.85
  surprise_skip_threshold: 0.92
  decay_rate: 0.01
  frequency_weight: 0.5
  history_max_turns: 50
  archive_turns_on_evict: true
  condenser:
    enabled: true
    strategy: masking
    keep_recent_n: 6
    keep_first: 2
    llm_summary_threshold: 100000

server:
  host: 0.0.0.0
  port: 8000
  cors_origins:
    - http://localhost:3000

storage:
  sqlite_path: data/sessions.db
  session_ttl_days: 30
  cleanup_interval_hours: 24

files:
  upload_dir: data/uploads
  max_upload_size_mb: 50
  max_files_per_session: 50
  cleanup_interval_hours: 24
  allowed_extensions:
    - .pdf
    - .docx
    - .txt
    - .md
    - .png
    - .jpg
    - .jpeg
    - .gif
  chunk_size: 512
  chunk_overlap: 64
  chroma_namespace: file
  query_min_score: 0.30
  llm_fallback_enabled: false
  ocr_enabled: true
  ocr_lang: chi_sim+eng      # 旧字段（保留，迁移到 ocr.tesseract.lang）
  ocr:
    primary_engine: paddle   # paddle | tesseract | none（缺依赖自动降级）
    paddle:
      lang: ch
      use_gpu: false
      min_confidence: 0.6    # 低于此置信度触发 L2 降级
      infer_timeout: 30      # 软超时（秒），超时记 warning 不强制终止
    tesseract:
      lang: chi_sim+eng      # 修复：从配置读取，不再硬编码
      preprocess: true       # 灰度+Otsu 二值化+中值滤波
    vision_llm:              # 视觉 LLM 终极兜底（本次 enabled=false，仅预留）
      enabled: false
      provider: qwen
      model: qwen-vl-max
      api_key: ${DASHSCOPE_API_KEY}
      base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
  max_injected_files: 5
  max_file_injection_tokens: 1000
  etl_max_queue: 100

history:
  persistence_dir: data/history

tools:
  max_react_loops: 50
  defer_loading_threshold: 20
  bash_timeout: 120

monitoring:
  enabled: true
  daily_persistence: true
  flush_interval_minutes: 60

interrupt:
  enabled: true
  breakpoint_threshold: 40
  graceful_timeout_seconds: 5

skills:
  mcp: []

security:
  enabled: true
  api_key: ''
  workspace_root: .
  approval_timeout_seconds: 300
  rules: []
  read_paths:
    mode: deny_first
    deny:
      - "src/"
      - "tests/"
      - ".git/"
      - ".trae/"
      - "__pycache__/"
      - "config.yaml"
      - "config.yaml.bak"
      - ".env"
      - "requirements.txt"
      - ".server.pid"
      - "*.pyc"
    allow:
      - "data/"
      - "web/"
      - "cron_tool/"
      - "tmp/"
      - "uploads/"

guardrails:
  input_scan:
    enabled: true
    action: warn
  sanitizer:
    enabled: true
    trusted_tools:
      - memory_search
      - search_memory
      - memory_query
    max_output_length: 20000
  output_filter:
    enabled: true
    enable_bank_card: true

web_search:
  bing_api_key: ${BING_API_KEY}
  baidu_api_key: ${BAIDU_API_KEY}

tasks: {}
schedules: []
cron:
  # inject_history: cron 触发时是否注入上次 run 的 llm_summary 摘要到上下文
  #   true: 注入 type=summary/fact 摘要（已过滤完整 conversation_turn，避免原文污染）
  #   false: 完全跳过检索，messages[0] 仅含运行环境段（最严格隔离）
  # 支持热更新即时生效（无需重启）
  inject_history: true
  # max_concurrency: 并发触发的最大 schedule 数（Phase 3 Task 15 限流用）
  # 超过阈值的触发排队等待，避免 100 schedule 同触发雪崩
  max_concurrency: 10

# Workflow 编排配置（可选，未配置时使用默认值）
# 访问 http://127.0.0.1:8000/workflow 可视化编排
workflow:
  # workflow 级默认超时（秒），单 step 可在 spec 中覆盖
  default_timeout_seconds: 3600
  # step 级默认重试策略（spec 中 on_failure.retry 可覆盖）
  default_retry:
    max_attempts: 3
    backoff_strategy: fixed  # fixed / linear / exponential
    base_delay_ms: 1000
    max_delay_ms: 30000
  # 内置模板白名单（deterministic step 的 template 字段只能用这些）
  # 不在此列表的 template 名会被 WorkflowValidator 拒绝
  allowed_templates:
    - directory_watch
    - summary
    - email_notify
    - cleanup_suggest
    - research
    - custom
