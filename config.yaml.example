# ============================================================
# teage-liu 配置模板
# 复制为 config.yaml 后按需修改，API Key 使用 ${VAR} 环境变量
# 或直接填入明文（不推荐提交到仓库）
# ============================================================

llm:
  main_provider: deepseek
  main_model: deepseek-v4-flash
  main_api_key: ${DEEPSEEK_API_KEY}
  main_base_url: https://api.deepseek.com
  consolidation_provider: deepseek
  consolidation_model: deepseek-v4-flash
  consolidation_api_key: ${DEEPSEEK_API_KEY}
  consolidation_base_url: https://api.deepseek.com
  max_context_tokens: 200000
  context_threshold: 0.8
  activity_timeout: 60
  stream_total_timeout: 300

memory:
  chroma_path: data/chroma
  memory_md_path: data/memory.md
  consolidation_threshold: 15
  dedup_similarity_threshold: 0.85
  retrieval_top_k: 5
  retrieval_relevance_threshold: 0.6
  surprise_gate_enabled: true
  surprise_similarity_threshold: 0.85
  surprise_skip_threshold: 0.92
  decay_rate: 0.01
  frequency_weight: 0.5
  history_max_turns: 50
  archive_turns_on_evict: true
  condenser:
    enabled: true
    strategy: masking
    keep_recent_n: 6
    keep_first: 2
    llm_summary_threshold: 100000

server:
  host: 0.0.0.0
  port: 8000
  cors_origins:
    - http://localhost:3000

storage:
  sqlite_path: data/sessions.db
  session_ttl_days: 30
  cleanup_interval_hours: 24

files:
  upload_dir: data/uploads
  max_upload_size_mb: 50
  max_files_per_session: 50
  cleanup_interval_hours: 24
  allowed_extensions:
    - .pdf
    - .docx
    - .txt
    - .md
    - .png
    - .jpg
    - .jpeg
    - .gif
  chunk_size: 512
  chunk_overlap: 64
  chroma_namespace: file
  query_min_score: 0.30
  llm_fallback_enabled: false
  ocr_enabled: true
  ocr_lang: chi_sim+eng      # 旧字段（保留，迁移到 ocr.tesseract.lang）
  ocr:
    primary_engine: paddle   # paddle | tesseract | none（缺依赖自动降级）
    paddle:
      lang: ch
      use_gpu: false
      min_confidence: 0.6    # 低于此置信度触发 L2 降级
      infer_timeout: 30      # 软超时（秒），超时记 warning 不强制终止
    tesseract:
      lang: chi_sim+eng      # 修复：从配置读取，不再硬编码
      preprocess: true       # 灰度+Otsu 二值化+中值滤波
    vision_llm:              # 视觉 LLM 终极兜底（本次 enabled=false，仅预留）
      enabled: false
      provider: qwen
      model: qwen-vl-max
      api_key: ${DASHSCOPE_API_KEY}
      base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
  max_injected_files: 5
  max_file_injection_tokens: 1000
  etl_max_queue: 100

history:
  persistence_dir: data/history

tools:
  max_react_loops: 50
  defer_loading_threshold: 20
  bash_timeout: 120

monitoring:
  enabled: true
  daily_persistence: true
  flush_interval_minutes: 60

interrupt:
  enabled: true
  breakpoint_threshold: 40
  graceful_timeout_seconds: 5

skills:
  mcp: []

security:
  enabled: true
  api_key: ''
  workspace_root: .
  approval_timeout_seconds: 300
  rules: []
  read_paths:
    mode: deny_first
    deny:
      - "src/"
      - "tests/"
      - ".git/"
      - ".trae/"
      - "__pycache__/"
      - "config.yaml"
      - "config.yaml.bak"
      - ".env"
      - "requirements.txt"
      - ".server.pid"
      - "*.pyc"
    allow:
      - "data/"
      - "web/"
      - "cron_tool/"
      - "tmp/"
      - "uploads/"

guardrails:
  input_scan:
    enabled: true
    action: warn
  sanitizer:
    enabled: true
    trusted_tools:
      - memory_search
      - search_memory
      - memory_query
    max_output_length: 20000
  output_filter:
    enabled: true
    enable_bank_card: true

web_search:
  bing_api_key: ${BING_API_KEY}
  baidu_api_key: ${BAIDU_API_KEY}

tasks: {}
schedules: []
cron:
  # inject_history: cron 触发时是否注入上次 run 的 llm_summary 摘要到上下文
  #   true: 注入 type=summary/fact 摘要（已过滤完整 conversation_turn，避免原文污染）
  #   false: 完全跳过检索，messages[0] 仅含运行环境段（最严格隔离）
  # 支持热更新即时生效（无需重启）
  inject_history: true
  # max_concurrency: 并发触发的最大 schedule 数（Phase 3 Task 15 限流用）
  # 超过阈值的触发排队等待，避免 100 schedule 同触发雪崩
  max_concurrency: 10
  # 调度执行强化（方案 A+）：4 个 hook 层（validate/catchup/retry/notify）
  # 每层独立开关，配置变更需重启（cron.hooks.* 不参与热重载）
  hooks:
    validate:
      enabled: true
    catchup:
      enabled: true
      default_policy: skip        # skip | execute_once
    retry:
      enabled: true
      max_retries: 3
      interval_seconds: 300
      transient_only: true        # true=permanent 错误不重试
    notify:
      enabled: true
      consecutive_failures_threshold: 3   # 连续失败 N 次后自动 disable
      channels:
        email:
          enabled: true
          smtp_host: ${SMTP_HOST}
          smtp_port: ${SMTP_PORT}
          sender_email: ${SMTP_USER}
          sender_password: ${SMTP_PASSWORD}
          receiver_email: ${NOTIFY_EMAIL}
          use_tls: true
        webhook:
          enabled: false
          url: ${WEBHOOK_URL}

# Workflow 编排配置（可选，未配置时使用默认值）
# 访问 http://127.0.0.1:8000/workflow 可视化编排
workflow:
  # workflow 级默认超时（秒），单 step 可在 spec 中覆盖
  default_timeout_seconds: 3600
  # step 级默认重试策略（spec 中 on_failure.retry 可覆盖）
  default_retry:
    max_attempts: 3
    backoff_strategy: fixed  # fixed / linear / exponential
    base_delay_ms: 1000
    max_delay_ms: 30000
  # 内置模板白名单（deterministic step 的 template 字段只能用这些）
  # 不在此列表的 template 名会被 WorkflowValidator 拒绝
  allowed_templates:
    - directory_watch
    - summary
    - email_notify
    - cleanup_suggest
    - research
    - custom

# ============================================================
# 多 Agent 协作配置（可选，未配置时 multiagent 默认禁用）
# 启用后工作台显示协作观察窗，Agent 可自主协作 + Director 引导
# 详见 docs/plans/2026-07-23-agent自主协作架构重设计.md
# ============================================================
multiagent:
  # 是否启用多 Agent 协作（false 时所有 /api/multiagent/* 端点返回 404）
  enabled: false
  # 当前实例角色：worker（参与协作）/ director（引导观察）
  role: worker
  # 黑板根目录（协议文件、消息、agent_card 等存放位置）
  # 支持相对路径（相对于工作目录）或绝对路径
  blackboard_dir: data/blackboard

  # Worker 配置（role=worker 时生效）
  worker:
    # 本 agent 的唯一标识（写入 agent_card.agent_id）
    # 默认 worker_001，多实例部署时需修改为唯一值
    agent_id: worker_001
    # Agent 版本号（写入 agent_card.agent_version）
    agent_version: "1.0.0"
    # 本 agent 声明的能力列表（用于其他 agent / Director 匹配协作请求）
    # 常见能力：file_read, file_write, execute_command, web_search,
    #          sentiment_analysis, translation, summarization, code_review
    capabilities: []
    # 专长领域（自由文本列表，用于协作匹配的语义补充）
    # 例：["Python后端", "数据分析", "文档撰写"]
    specialties: []
    # 心跳上报间隔（秒），Director 据此判断 worker 是否存活
    heartbeat_interval_seconds: 10
    # 危险工具白名单（写入 agent_card，供 Director 审计）
    # 常见：execute_command, write_file, call_tool
    dangerous_tools: []
    # 服务端点（写入 agent_card.endpoint，供其他 agent A2A 调用）
    endpoint: "http://localhost:8000"
    # 所有者标识（写入 agent_card.owner）
    owner: ""
    # 最大并发任务数（写入 agent_card.max_concurrent_tasks）
    max_concurrent_tasks: 3
    # 认证方式（写入 agent_card.auth_method）
    # 可选：local, api_key, signed, oauth2, mtls
    auth_method: local
    # 初始信任分数（0-100，写入 agent_card.trust_score）
    trust_score: 100

  # Director 配置（role=director 时生效）
  director:
    # 是否强制执行 director.md 中的规则
    enforce_rules: true
    # 冲突仲裁策略：llm_arbitration（LLM 仲裁）/ priority（优先级仲裁）
    conflict_strategy: llm_arbitration
    # 单轮次超时（秒），超时后强制推进轮次
    turn_timeout_seconds: 30
    # Director 心跳超时（秒），worker 据此判断是否进入自治模式
    heartbeat_timeout_seconds: 30
    # 降级阈值（秒），age 超过此值但未超 timeout 时标记 degraded
    degraded_threshold_seconds: 20
    # 自治模式 grace period（秒）
    grace_period_seconds: 2
    # Director 故障恢复锁超时（秒）
    recovery_lock_timeout: 30
    # Director 故障时 worker 的 fallback 策略：priority / round_robin
    fallback_strategy: priority

  # 协作参数（Task 13 新增，热重载生效）
  collab:
    # 协作消息轮询间隔（秒），WorkerAdapter._collab_poll_loop 使用
    poll_interval_seconds: 2
    # 空闲超时阈值（秒）：超过此时间无 A2A 调用且队列非空 → 触发 LLM 调用
    idle_timeout_seconds: 60
    # 紧急队列最大长度（directive intervention / 用户广播）
    urgent_queue_max_size: 10
    # 普通队列最大长度（directive ordering / relay / request 非用户广播）
    normal_queue_max_size: 100
    # 休眠模式：连续 N 次空轮询后进入休眠（0=禁用，默认禁用以保持兼容）
    # 休眠期停止完整轮询，仅 stat collaboration.md 的 mtime 做廉价唤醒探针
    # 新消息写入会改动 mtime，触发唤醒切回活跃模式
    sleep_after_empty_polls: 0
    # 休眠模式唤醒探针间隔（秒），建议 30s 兼顾响应性与省资源
    sleep_poll_interval_seconds: 30


# ============ A2A（Agent-to-Agent，标准 A2A v1.0）============
a2a:
  # 是否启用 A2A 子系统（false 时不注册 A2A 路由/客户端/工具）
  enabled: false
  # 对端实例端点（本地 ↔ 服务器双实例互连时各指向对方）
  remote_endpoints:
  - name: worker-2
    url: "http://localhost:8001"
  # 标准 A2A v1.0 面（协议底线：完整达标后再谈扩展）
  standard:
    enabled: true
    name: "worker_001"        # Agent Card name（缺省用 multiagent.worker.agent_id）
    description: "Teage Liu personal AI agent"
    base_url: ""              # 空 → 开发态从 TEAGE_HOST/TEAGE_PORT 推导
    endpoint_url: ""          # 空 → base_url + /a2a/std/jsonrpc
    version: ""
    capabilities:
      streaming: true
      push_notifications: false
    default_input_modes: ["text", "text/plain"]
    default_output_modes: ["text", "text/plain"]
    skills: []
    security_schemes: []      # 空 → 自动 [{scheme: bearer}] iff security.api_key
    mode: "legacy"            # legacy | standard（工具路由；标准达标后翻转）
    task_store_path: ""       # 缺省 {multiagent.blackboard_dir}/tasks/a2a/tasks.json
    extensions_enabled: true  # 旧自定义方法作为 A2A 扩展（A2A-Extensions 头门控）
    extensions: [list_agents, read_messages, append_message, acquire_lock,
                 release_lock, read_director_md, register_remote_agent, heartbeat,
                 read_file, director_broadcast, agent_message, collab_message]
