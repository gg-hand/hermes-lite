# ── 敏感文件 ──
# API Key 使用 ${VAR} 环境变量注入，不存明文
# 本地覆盖配置放 config.yaml.bak（自动忽略）
config.yaml.bak
.env
# .env.example 仅含占位符模板，需提交以便用户参考

# ── 运行时数据（数据库、日志、向量库、会话历史） ──
data/
!data/.gitkeep

# ── IDE / 编辑器 ──
.trae/
.idea/
.vscode/
*.swp
*.swo

# ── 调试 / 临时文件 ──
scratch/
tmp/
debug_*.py
debug_*.txt
fix*.py
*bug_fix*.py
analyze_*.py
wbi_*.py
bili_wbi_test*.py
*_out.json
*_out.txt
sv*.txt
output.txt
search_params.txt
out_parse.txt

# 深层调试文件（任意目录）
**/fix*.py
**/analyze_*.py
**/builtin_tools_fixed.py

# ── 启动输出重定向 ──
server_out.txt
server_err.txt

# ── Python ──
__pycache__/
*.pyc
.venv/
.pytest_cache/

# ── 系统生成 ──
*.log
.server.pid

# ── 截图 / 图片工件 ──
tests/*.png
tests/*.jpg

# ── 个人笔记 / 研究文档 ──
*价格对比*.md
*云服务器*.md

# ── ONNX 模型（可重新下载） ──
_onnx_model/

# ── 部署包 ──
*.tar.gz
deploy/

# ── Windows 工件 ──
$null
Thumbs.db

# ── Desktop 桌面端（由 feature/desktop-v0.1.0 分支管理，dev 不介入） ──
desktop/

# 架构清理：备份目录和调试脚本
hermes-lite.bak.*/
hermes-lite/_test_*.py
hermes-lite/bili_*.py
hermes-lite/debug_*.txt
hermes-lite/server_*.txt
hermes-lite/sv*.txt
